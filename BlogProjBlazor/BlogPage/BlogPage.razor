@using System.Diagnostics.CodeAnalysis
@using Markdig
@using Markdig.Syntax
@using Microsoft.AspNetCore.Components.Rendering
@using Block = Markdig.Syntax.Block
@inject HttpClient Http
<h3>BlogPage</h3>

@code {
    [Parameter] [StringSyntax(StringSyntaxAttribute.Uri)]
    public required string MarkPath { get; set; }
    private MarkdownDocument? _document;
    protected override async Task OnParametersSetAsync()
    {
        var markdown = await Http.GetStringAsync(MarkPath);

        _document = Markdown.Parse(markdown,new MarkdownPipelineBuilder()
            .UseAdvancedExtensions()
            .Build());
        RenderDocument(_document);
    }
    private RenderFragment RenderDocument(MarkdownDocument doc)
        => builder =>
        {
            foreach(var block in doc)
            {
                RenderBlock(builder, block);
            }
        };

    private partial void RenderBlock(RenderTreeBuilder builder, Block block);
}